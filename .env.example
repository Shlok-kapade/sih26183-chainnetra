# ── Database ──────────────────────────────────────────────────────────────────
# Used by docker-compose to create the Postgres container and connect the app.
# If you use RDS, set DATABASE_URL directly and comment out the db service.
DATABASE_URL=postgresql+asyncpg://chainnetra:changeme@db:5432/chainnetra
POSTGRES_PASSWORD=changeme

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random secret:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── App mode ──────────────────────────────────────────────────────────────────
# Set to True to enable live blockchain tracing (requires API keys below)
LIVE_MODE=True

# ── Blockchain API Keys ───────────────────────────────────────────────────────
# TronGrid (https://www.trongrid.io) — get a free key at dashboard.trongrid.io
TRONGRID_API_KEY=your-trongrid-key-here

# Tronscan (https://tronscan.org) — used as fallback
TRONSCAN_API_KEY=your-tronscan-key-here

# Etherscan (https://etherscan.io) — for ETH/ERC20 traces
ETHERSCAN_API_KEY=your-etherscan-key-here

# ── Port ──────────────────────────────────────────────────────────────────────
# Port nginx listens on externally (default 80; use 443 if you add TLS)
HTTP_PORT=80
